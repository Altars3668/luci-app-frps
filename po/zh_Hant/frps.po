#: applications/luci-app-frps/htdocs/luci-static/resources/view/frps.js:982
msgid "Access Control"
msgstr "存取控制"

#: applications/luci-app-frps/htdocs/luci-static/resources/view/frps.js:1008
msgid "Add new HTTP plugin..."
msgstr "新增新的 HTTP 外掛..."

